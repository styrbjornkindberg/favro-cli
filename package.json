{
  "name": "@square-moon/favro-cli",
  "version": "4.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/styrbjornkindberg/favro-cli.git"
  },
  "bugs": {
    "url": "https://github.com/styrbjornkindberg/favro-cli/issues"
  },
  "description": "Favro command-line interface",
  "main": "dist/index.js",
  "//files": "#128 defence in depth: a build-config regression must not ship test code. `skills` is runtime — skill-store.ts resolves <pkg>/skills/builtin.",
  "files": [
    "dist",
    "skills",
    "!dist/**/__tests__",
    "!dist/**/__integration__",
    "!dist/**/test-support",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "bin": {
    "favro": "dist/cli.js",
    "favro-mcp": "dist/mcp-server.js",
    "favro-mcp-http": "dist/mcp-http-server.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check:cycles": "madge --circular --extensions ts src",
    "prepack": "npm run build",
    "mcp": "node dist/mcp-server.js",
    "mcp:http": "node dist/mcp-http-server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "enquirer": "^2.4.1",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "madge": "8.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "favro",
    "cli"
  ]
}
